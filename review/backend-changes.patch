+  const meta = { type: 'body', metatype: CreateOrderDto };
+  assert.equal((await pipe.transform(body, meta)).paymentStatus, 'UNPAID');
+  await assert.rejects(pipe.transform({ ...body, paymentStatus: 'PAID' }, meta), status(400));
