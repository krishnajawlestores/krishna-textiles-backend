generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum CustomerType {
  RETAIL
  WHOLESALE
  VIP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum OfferTarget {
  ALL
  CATEGORY
  BRAND
  PRODUCT
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(ADMIN)
  phone        String?
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id            String   @id @default(uuid())
  userId        String
  token         String   @unique
  ipAddress     String?
  userAgent     String?
  deviceType    String?
  isValid       Boolean  @default(true)
  expiresAt     DateTime
  revokedReason String?
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isValid])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  image       String?
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  image       String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Product {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  brand         String
  brandId       String
  category      String
  categoryId    String?
  brandRefId    String?
  price         Float
  mrp           Float
  discount      Float            @default(0)
  rating        Float            @default(4.5)
  reviews       Int              @default(0)
  imageUrl      String?
  images        String[]         @default([])
  colors        Json?            @default("[]")
  bestSeller    Boolean          @default(false)
  description   String?
  sizes         String[]
  stock         Int              @default(0)
  minStockAlert Int              @default(20)
  sku           String           @unique
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  audits        InventoryAudit[]
  orderItems    OrderItem[]
  categoryRef   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandRef      Brand?           @relation(fields: [brandRefId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([brandId])
  @@index([sku])
  @@index([categoryId])
}

model InventoryAudit {
  id            String   @id @default(uuid())
  productId     String
  previousStock Int
  newStock      Int
  delta         Int
  reason        String
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Customer {
  id          String         @id @default(uuid())
  name        String
  email       String?        @unique
  phone       String         @unique
  company     String?
  gstin       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  type        CustomerType   @default(RETAIL)
  creditLimit Float          @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  notes       CustomerNote[]
  orders      Order[]

  @@index([type])
  @@index([phone])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  note       String
  author     String   @default("Admin")
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Order {
  id              String              @id @default(uuid())
  orderNumber     String              @unique
  customerId      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  status          OrderStatus         @default(PENDING)
  subtotal        Float
  taxAmount       Float               @default(0)
  discountAmount  Float               @default(0)
  couponCode      String?
  totalAmount     Float
  paymentStatus   PaymentStatus       @default(UNPAID)
  paymentMethod   String              @default("ONLINE_GPAY")
  shippingAddress String?
  courierPartner  String?
  trackingNumber  String?
  dispatchedAt    DateTime?
  expectedDeliveryDate DateTime?
  notes           String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentProofUrl   String?             @db.Text
  paymentReceivedAt DateTime?
  paymentNotes      String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  history     OrderStatusHistory[]

  @@index([status])
  @@index([orderNumber])
  @@index([customerId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?     @default("System")
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  size        String?
  color       String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Coupon {
  id                  String     @id @default(uuid())
  code                String     @unique
  description         String?
  type                CouponType @default(PERCENTAGE)
  value               Float
  minOrderAmount      Float      @default(0)
  maxDiscountAmount   Float?
  usageLimit          Int?
  usedCount           Int        @default(0)
  isActive            Boolean    @default(true)
  validFrom           DateTime   @default(now())
  validUntil          DateTime?
  applicableCategories String[]  @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([code])
  @@index([isActive])
}

model Offer {
  id            String      @id @default(uuid())
  title         String
  description   String?
  bannerImage   String?
  discountType  CouponType  @default(PERCENTAGE)
  discountValue Float
  targetType    OfferTarget @default(ALL)
  targetId      String?
  targetName    String?
  isActive      Boolean     @default(true)
  startDate     DateTime    @default(now())
  endDate       DateTime?
  priority      Int         @default(0)
  badgeText     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([isActive])
  @@index([targetType])
}
